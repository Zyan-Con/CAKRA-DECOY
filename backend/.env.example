# CAKRA-DECOY 2.0 — Backend Environment Configuration
# Pilihan Mode AI: "groq" | "gemini" | "ollama" | "deterministic"
AI_PROVIDER=groq

# Groq Cloud API (Cepat < 500ms untuk Live Demo)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Opsional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Air-Gapped On-Premise Mode (Ollama Lokal Satuan TNI AD)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Konfigurasi Server & Deception Threshold
PORT=8000
THREAT_SCORE_THRESHOLD=70
