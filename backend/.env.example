# CAKRA-DECOY 2.0 — Backend Environment Configuration
# Pilihan Mode AI: "groq" | "gemini" | "ollama" | "9router" | "openai" | "deterministic"
AI_PROVIDER=groq

# Groq Cloud API (Cepat < 500ms untuk Live Demo)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Opsional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Air-Gapped On-Premise Mode (Ollama Lokal Satuan TNI AD)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gateway OpenAI-compatible (AI_PROVIDER=9router | openai) — 9Router, OpenRouter, vLLM, LM Studio, dll.
# 9Router lokal default base = http://localhost:20128/v1 (boleh dikosongkan untuk 9router).
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_gateway_key_here
LLM_MODEL=cc/claude-opus-4-7

# Timeout LLM tier-2 (detik). Jika terlampaui -> fallback statis deterministik.
# Set AI_PROVIDER=deterministic (atau kosongkan) untuk mematikan LLM sepenuhnya.
LLM_TIMEOUT_S=6

# Konfigurasi Server & Deception Threshold
PORT=8000
THREAT_SCORE_THRESHOLD=70

# Demo emitter: 1 = pancarkan event palsu ke frontend (buat dev FE), 0 = mati
DEMO_EMITTER=1
